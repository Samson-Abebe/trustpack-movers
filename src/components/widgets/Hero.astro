
---
import Button from '~/components/ui/Button.astro';
import truckImage from '~/assets/images/hero/hero_1.png';
import truckImage_ from '~/assets/images/hero/hero_2.jpg';
import truckImage__ from '~/assets/images/hero/hero_3.jpg';
import truckImage_4 from '~/assets/images/hero/hero_4.jpg';
import truckImage_5 from '~/assets/images/hero/hero_5.jpg';
import truckImage_6 from '~/assets/images/hero/hero_6.jpg';

import type { Hero as Props } from '~/types';

interface ExtendedHeroProps extends Props {
  slides?: Array<{ src: string; alt?: string }>;
}

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  badge,

  content = await Astro.slots.render('content'),
  actions = await Astro.slots.render('actions'),
  image = await Astro.slots.render('image'),
  slides = [],

  id,
  bg = await Astro.slots.render('bg'),
} = Astro.props as ExtendedHeroProps;

const defaultSlides = [
  {
    src: truckImage.src,
    alt: 'Moving boxes and home packing',
  },
  {
    src: truckImage_.src,
    alt: 'Furniture arranged in a new home',
  },
  {
    src: truckImage__.src,
    alt: 'Beautiful home ready for relocation',
  },
    {
    src: truckImage_4.src,
    alt: 'Beautiful home ready for relocation',
  },
    {
    src: truckImage_5.src,
    alt: 'Beautiful home ready for relocation',
  },
    {
    src: truckImage_6.src,
    alt: 'Beautiful home ready for relocation',
  },
];

const activeSlides = slides.length > 0 ? slides : defaultSlides;
---

<section 
  class="relative bg-slate-950 sm:min-h-[440px] lg:min-h-[500px] flex flex-col sm:flex-row sm:items-center sm:justify-center overflow-hidden not-prose shadow-2xl" 
  {...id ? { id } : {}}
>
  
  <!-- Image Slider: Compact height on Mobile, Full-coverage background on Desktop -->
  <div class="relative sm:absolute sm:inset-0 w-full h-[200px] sm:h-full overflow-hidden z-0 bg-slate-900 shrink-0">
    <div class="hero-slider relative w-full h-full">
      {activeSlides.map((slide, index) => (
        <div 
          class={`hero-slide absolute inset-0 transition-opacity duration-1000 ease-in-out backface-hidden ${
            index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'
          }`}
          data-slide-index={index}
        >
          <img 
            src={slide.src} 
            alt={slide.alt || 'Hero Slide'} 
            class="w-full h-full object-cover sm:object-fill object-center backface-hidden"
            loading={index === 0 ? 'eager' : 'lazy'}
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-black/20 sm:bg-gradient-to-r sm:from-black/85 sm:via-black/50 sm:to-black/15 pointer-events-none"></div>
        </div>
      ))}
    </div>

    <!-- Navigation Dots -->
    <div class="absolute bottom-2.5 sm:bottom-4 left-1/2 -translate-x-1/2 z-20 flex gap-2 drop-shadow-md">
      {activeSlides.map((_, index) => (
        <span 
          class={`hero-dot w-2 h-2 sm:w-2.5 sm:h-2.5 rounded-full transition-all duration-300 ${index === 0 ? 'bg-white w-5 sm:w-6 shadow' : 'bg-white/50'}`}
          data-dot-index={index}
        ></span>
      ))}
    </div>
  </div>

  <!-- Content: Compact on Mobile & Desktop -->
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 pt-4 pb-8 sm:py-12 lg:py-16 z-10 w-full text-white bg-slate-950 sm:bg-transparent">
    <div class="max-w-2xl">
      {badge && (
        <span class="inline-block mb-2.5 sm:mb-3 rounded-full border border-white/25 bg-white/10 sm:bg-black/40 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-white backdrop-blur-md shadow-lg">
          {badge}
        </span>
      )}
      {tagline && (
        <p class="text-xs sm:text-sm text-blue-300 font-bold tracking-wide uppercase mb-1.5 drop-shadow-md" set:html={tagline} />
      )}

      <!-- Mobile-Only Custom Tagline Line -->
      <span class="block mb-2 sm:hidden font-bold text-blue-400 text-sm tracking-wide drop-shadow">
        Trustpack & Move: Fast, Safe, Reliable.
      </span>

      {title && (
        <h1 class="text-2xl sm:text-4xl lg:text-5xl font-bold leading-tight tracking-tight mb-3 sm:mb-4 font-heading text-white drop-shadow-[0_4px_12px_rgba(0,0,0,0.85)]" set:html={title} />
      )}

      <!-- Hidden on mobile (hidden sm:block) -->
      {subtitle && (
        <p class="hidden sm:block text-base sm:text-lg text-slate-200 mb-5 sm:mb-6 leading-relaxed drop-shadow-[0_2px_8px_rgba(0,0,0,0.85)] font-medium" set:html={subtitle} />
      )}

      {actions && (
        <div class="flex flex-col sm:flex-row gap-2.5 sm:gap-4 mb-2 sm:mb-3 drop-shadow-lg">
          {Array.isArray(actions) ? (
            actions.map((action) => (
              <div class="flex w-full sm:w-auto">
               <Button
  {...(action || {})}
  class="w-full sm:mb-0 text-white hover:text-black shadow-xl hover:shadow-2xl transition-all duration-300"
/>
              </div>
            ))
          ) : (
            <Fragment set:html={actions} />
          )}
        </div>
      )}

      {content && <div class="mt-2 sm:mt-3 text-xs sm:text-sm text-slate-300 drop-shadow" set:html={content} />}
    </div>
  </div>
</section>

<style>
  .backface-hidden {
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    will-change: opacity;
  }
</style>

<script>
  function setupHeroSlider() {
    const sliderContainers = document.querySelectorAll('.hero-slider');
    if (!sliderContainers.length) return;

    sliderContainers.forEach((container) => {
      const slides = container.querySelectorAll('.hero-slide');
      const dots = container.parentElement?.querySelectorAll('.hero-dot');
      if (!slides.length) return;

      let currentIndex = 0;
      const intervalTime = 4500;

      setInterval(() => {
        const prevIndex = currentIndex;
        currentIndex = (currentIndex + 1) % slides.length;

        const prevSlide = slides[prevIndex];
        prevSlide.classList.remove('opacity-100', 'z-10');
        prevSlide.classList.add('opacity-0', 'z-0');

        const currentSlide = slides[currentIndex];
        currentSlide.classList.remove('opacity-0', 'z-0');
        currentSlide.classList.add('opacity-100', 'z-10');

        if (dots) {
          dots.forEach((dot, idx) => {
            if (idx === currentIndex) {
              dot.classList.remove('bg-white/50');
              dot.classList.add('bg-white', 'w-5', 'sm:w-6', 'shadow');
            } else {
              dot.classList.remove('bg-white', 'w-5', 'sm:w-6', 'shadow');
              dot.classList.add('bg-white/50');
            }
          });
        }
      }, intervalTime);
    });
  }

  setupHeroSlider();
  document.addEventListener('astro:after-swap', setupHeroSlider);
</script>
