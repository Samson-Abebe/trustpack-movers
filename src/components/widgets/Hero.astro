---
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';

import type { Hero as Props } from '~/types';

interface ExtendedHeroProps extends Props {
  slides?: Array<{ src: string; alt?: string }>;
}

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  badge,

  content = await Astro.slots.render('content'),
  actions = await Astro.slots.render('actions'),
  image = await Astro.slots.render('image'),
  slides = [],

  id,
  bg = await Astro.slots.render('bg'),
} = Astro.props as ExtendedHeroProps;

const { aspect: imageAspect, ...imageProps } = typeof image === 'object' && image ? image : { src: '', alt: '' };
const imageWhole = imageAspect === 'auto';

// Default images for the slider if none are passed in `slides`
const defaultSlides = [
  {
    src: 'https://images.unsplash.com/photo-1600518464441-9154a4dea21b?auto=format&fit=crop&w=1400&q=80',
    alt: 'Moving boxes and home packing',
  },
  {
    src: 'https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=1400&q=80',
    alt: 'Furniture arranged in a new home',
  },
  {
    src: 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1400&q=80',
    alt: 'Beautiful home ready for relocation',
  },
];

const activeSlides = slides.length > 0 ? slides : defaultSlides;
---

<section class="relative md:-mt-[76px] not-prose overflow-hidden" {...id ? { id } : {}}>
  <!-- Background Decorator -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <slot name="bg">
      {bg ? <Fragment set:html={bg} /> : (
        <div class="absolute inset-0 bg-gradient-to-b from-blue-50/50 via-transparent to-transparent dark:from-slate-900/50"></div>
      )}
    </slot>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
    <div class="pt-0 md:pt-[76px] pointer-events-none"></div>
    <div class="py-12 md:py-20 lg:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        
        <!-- Left Content Column -->
        <div class="lg:col-span-6 text-left">
          {badge && (
            <span class="inline-block mb-4 rounded-full border border-primary/30 bg-primary/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-primary dark:bg-primary/25 dark:text-blue-200">
              {badge}
            </span>
          )}
          {tagline && (
            <p class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase mb-2" set:html={tagline} />
          )}
          {title && (
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight tracking-tight mb-6 font-heading text-heading" set:html={title} />
          )}

          <!-- Mobile Only Image Slider (Visible on screens smaller than lg) -->
          <div class="block lg:hidden w-full mb-6">
            <div class="relative w-full h-[260px] sm:h-[380px] rounded-2xl overflow-hidden shadow-2xl border border-slate-200/50 dark:border-slate-800/50 bg-slate-100 dark:bg-slate-800">
              <div class="hero-slider relative w-full h-full">
                {activeSlides.map((slide, index) => (
                  <div 
                    class={`hero-slide absolute inset-0 transition-opacity duration-1000 ease-in-out ${index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`}
                    data-slide-index={index}
                  >
                    <img 
                      src={slide.src} 
                      alt={slide.alt || 'Hero Slide'} 
                      class="w-full h-full object-cover" 
                      loading={index === 0 ? 'eager' : 'lazy'}
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/30 via-transparent to-transparent pointer-events-none"></div>
                  </div>
                ))}
              </div>
              <div class="absolute bottom-5 left-1/2 -translate-x-1/2 z-20 flex gap-2">
                {activeSlides.map((_, index) => (
                  <span 
                    class={`hero-dot w-2.5 h-2.5 rounded-full transition-all duration-300 ${index === 0 ? 'bg-white w-6' : 'bg-white/50'}`}
                    data-dot-index={index}
                  ></span>
                ))}
              </div>
            </div>
          </div>

          {subtitle && (
            <p class="text-lg sm:text-xl text-muted mb-8 dark:text-slate-300 leading-relaxed" set:html={subtitle} />
          )}

          {actions && (
            <div class="flex flex-col sm:flex-row gap-4 mb-6">
              {Array.isArray(actions) ? (
                actions.map((action) => (
                  <div class="flex w-full sm:w-auto">
                    <Button {...(action || {})} class="w-full sm:mb-0 shadow-lg hover:shadow-xl transition-all duration-300" />
                  </div>
                ))
              ) : (
                <Fragment set:html={actions} />
              )}
            </div>
          )}

          {content && <div class="mt-4 text-sm text-muted dark:text-slate-400" set:html={content} />}
        </div>

        <!-- Desktop Only Image Slider (Hidden on mobile, visible on lg screens and up) -->
        <div class="hidden lg:block col-span-1 lg:col-span-6 w-full">
          <div class="relative w-full h-[480px] rounded-2xl overflow-hidden shadow-2xl border border-slate-200/50 dark:border-slate-800/50 bg-slate-100 dark:bg-slate-800">
            <div class="hero-slider relative w-full h-full">
              {activeSlides.map((slide, index) => (
                <div 
                  class={`hero-slide absolute inset-0 transition-opacity duration-1000 ease-in-out ${index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`}
                  data-slide-index={index}
                >
                  <img 
                    src={slide.src} 
                    alt={slide.alt || 'Hero Slide'} 
                    class="w-full h-full object-cover" 
                    loading={index === 0 ? 'eager' : 'lazy'}
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/30 via-transparent to-transparent pointer-events-none"></div>
                </div>
              ))}
            </div>
            <div class="absolute bottom-5 left-1/2 -translate-x-1/2 z-20 flex gap-2">
              {activeSlides.map((_, index) => (
                <span 
                  class={`hero-dot w-2.5 h-2.5 rounded-full transition-all duration-300 ${index === 0 ? 'bg-white w-6' : 'bg-white/50'}`}
                  data-dot-index={index}
                ></span>
              ))}
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<script>
  function setupHeroSlider() {
    const sliderContainers = document.querySelectorAll('.hero-slider');
    if (!sliderContainers.length) return;

    sliderContainers.forEach((container) => {
      const slides = container.querySelectorAll('.hero-slide');
      const dots = container.parentElement?.querySelectorAll('.hero-dot');
      if (!slides.length) return;

      let currentIndex = 0;
      const intervalTime = 4000;

      setInterval(() => {
        slides[currentIndex].classList.remove('opacity-100', 'z-10');
        slides[currentIndex].classList.add('opacity-0', 'z-0');
        if (dots && dots[currentIndex]) {
          dots[currentIndex].classList.remove('bg-white', 'w-6');
          dots[currentIndex].classList.add('bg-white/50');
        }

        currentIndex = (currentIndex + 1) % slides.length;

        slides[currentIndex].classList.remove('opacity-0', 'z-0');
        slides[currentIndex].classList.add('opacity-100', 'z-10');
        if (dots && dots[currentIndex]) {
          dots[currentIndex].classList.remove('bg-white/50');
          dots[currentIndex].classList.add('bg-white', 'w-6');
        }
      }, intervalTime);
    });
  }

  setupHeroSlider();
  document.addEventListener('astro:after-swap', setupHeroSlider);
</script>