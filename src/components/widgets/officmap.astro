---
interface Props {
  officeName: string;
  address?: string;
  mapEmbedUrl: string;
  mapLink: string; // Make this required for the button
  phone?: string;
  email?: string;
}

const { officeName, address, mapEmbedUrl, mapLink, phone, email } = Astro.props;
---

<div class="bg-white rounded-2xl shadow-lg overflow-hidden border border-gray-100 flex flex-col lg:flex-row transition-all duration-300 hover:shadow-xl">
  <!-- Office Details Section -->
  <div class="p-8 lg:w-1/3 flex flex-col justify-between">
    <div>
      <span class="inline-block px-3 py-1 text-xs font-semibold text-blue-600 bg-blue-50 rounded-full mb-3">
        Office Location
      </span>
      <h3 class="text-2xl font-bold text-gray-900 mb-2">{officeName}</h3>
      {address && <p class="text-gray-600 mb-6 leading-relaxed">{address}</p>}
      
      <div class="space-y-3 mb-6">
        {phone && (
          <div class="flex items-center text-gray-700 text-sm">
            <svg class="w-4 h-4 mr-3 text-blue-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            <a href={`tel:${phone}`} class="hover:text-blue-600 transition-colors">{phone}</a>
          </div>
        )}
        
        {email && (
          <div class="flex items-center text-gray-700 text-sm">
            <svg class="w-4 h-4 mr-3 text-blue-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            <a href={`mailto:${email}`} class="hover:text-blue-600 transition-colors">{email}</a>
          </div>
        )}
      </div>
    </div>
    
    <!-- Uses mapLink exclusively for the external tab -->
    <a 
      href={mapLink} 
      target="_blank" 
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center px-4 py-3 bg-gray-900 text-white text-sm font-medium rounded-xl hover:bg-blue-600 transition-colors shadow-sm"
    >
      Open in Google Maps
      <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
      </svg>
    </a>
  </div>

  <!-- Responsive Map Embed Section (uses mapEmbedUrl strictly inside iframe) -->
  <div class="lg:w-2/3 h-80 lg:h-auto min-h-[350px] bg-gray-100 relative">
    <iframe
      src={mapEmbedUrl}
      width="100%"
      height="100%"
      style="border:0;"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"
      class="w-full h-full absolute inset-0"
      title={`Map showing location of ${officeName}`}
    ></iframe>
  </div>
</div>