---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/hero__.astro';

import Features2 from '~/components/widgets/Features2.astro';

import FeatureTabs from '~/components/widgets/FeatureTabs.astro';
import Gallery from '~/components/widgets/Gallery.astro';

import trust from '~/assets/images/trust.jpg';
import gl from '~/assets/images/gl/gl_1.jpg';
import gl1 from '~/assets/images/gl/gl_2.jpg';
import gl2 from '~/assets/images/gl/gl_3.jpg';
import gl3 from '~/assets/images/gl/gl_4.jpg';
import gl4 from '~/assets/images/gl/gl_5.jpg';
import gl5 from '~/assets/images/gl/gl_6.jpg';
// A product details landing page presents one product at three depths: what it
// is, what it does, and exactly what you get. The product here is real (this
// template), so the page is both a working example and a guide: each section is
// one a product page needs, and says why. Replace the product; keep the depths.



const metadata = {
  title: 'Product Details Landing Page Example & Guide',
  description:
    'A complete product details landing page built with AstroWind: overview, key features, specifications, getting started, price and availability, proof and FAQ, with notes on why each block belongs. Free Astro template.',
  openGraph: { type: 'website' },
};


---

<Layout metadata={metadata}>
  <!-- 1. Hero: one product, one line, one action -->

  <Hero
    tagline="💬 What Our Customers Say ⭐"
    title="Stories from families and businesses who trust us!"
    
    image={{
      src:trust,
      alt: 'A spotlight on a product. Product Details Landing Page Demo',
    }}
  />



  <!-- 2. Overview: the first depth -->



  <!-- 3. Key features: the second depth -->

  <FeatureTabs
    id="features"
  
    title="Real Moves, Real Stories — See Why Families Trust Us"
    subtitle="Pick a moving category below to watch real video highlights and feedback from customers who booked their relocation with TrustPack & Mover."
    items={[
      {
        title: 'Elias Wesenyeleh',
        description:
          '“You did an amazing job! Your speed and the care you took with my packages truly impressed me. I’m very happy with your service and would gladly trust you with my belongings again.”',
        icon: 'tabler:components',
         
        videoSrc: 'https://www.tiktok.com/player/v1/7546902688492031237?embed_from=webapp_share&music_info=1&description=1&autoplay=0&muted=0',
      },
      {
        title: 'Joseph JO JO',
        description:
          '“TrustPack made my work easier! Thank you, team, for your excellent service. I highly recommend them!”',
           icon: 'tabler:components',
        
        videoSrc: 'https://www.tiktok.com/player/v1/7544301347596799238?embed_from=webapp_share&music_info=1&description=1&autoplay=0&muted=0',
      },
      {
        title: 'Heaven hevu',
        description:
          '“Moving while pregnant was stressful, but TrustPack made everything easy and worry-free with their excellent service and care. Thank you, TrustPack team!”',
         icon: 'tabler:components',
        videoSrc: 'https://www.tiktok.com/player/v1/7542436202205482296?embed_from=webapp_share&music_info=1&description=1&autoplay=0&muted=0',
      },
      {
        title: 'Yohanis Teshome',
        description:
          '“TrustPack made our move smooth and stress-free! Their team handled every item with care and delivered everything safely and on time. Highly recommended!”',
         icon: 'tabler:components',
        videoSrc: 'https://www.tiktok.com/player/v1/7559308135010290956?embed_from=webapp_share&music_info=1&description=1&autoplay=0&muted=0',
      },
    ]}
  >
  <Fragment slot="bg">
  <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
</Fragment>
</FeatureTabs>
  <!-- 4. Specifications: the third depth -->

  
  <!-- 5. Gallery: let them look at it from every angle -->

  <Gallery
    id="gallery"
    tagline="Gallery"
    title="Show it from every angle"
    subtitle="From careful packing and secure loading to safe transportation and final delivery, see how our team handles your belongings with care at every stage of the moving process."
 images={[
  {
    src: gl,
    alt: 'Packed moving boxes ready for relocation',
    caption: 'Together We Move, Together We Deliver',
  },
  {
    src: gl1,
    alt: 'Beautiful home ready for relocation',
    caption: 'Making every move feel like home',
  },
  {
    src: gl2,
    alt: 'Furniture arranged inside a modern home',
    caption: 'Professional furniture handling',
  },
  {
    src: gl3,
    alt: 'Spacious home interior',
    caption: 'Moving into your new space',
  },
  {
    src: gl4,
    alt: 'Modern residential interior',
    caption: 'Reliable home relocation',
  },
  {
    src: gl5,
    alt: 'Carefully furnished living space',
    caption: 'Your belongings handled with care',
  },
]}
  />
  

  <!-- 6. Getting started: what happens after the decision -->

 
  <!-- 6. Rules of thumb -->

  <Features2
  id="trust"
  tagline="Why Choose Us"
  title="Moving You Can Trust"
  subtitle="We make every move easier with careful packing, reliable transportation, and professional service from start to finish."
  columns={4}
  items={[
    {
      title: 'Safe Packing & Handling',
      description: 'We carefully pack, load, and transport your belongings to keep them protected throughout the move.',
      icon: 'tabler:package',
    },
    {
      title: 'On-Time Delivery',
      description: 'We value your time and work hard to deliver your belongings safely according to the agreed schedule.',
      icon: 'tabler:clock-check',
    },
    {
      title: 'Professional Moving Team',
      description: 'Our dedicated team handles household goods and business equipment with care and attention.',
      icon: 'tabler:users',
    },
    {
      title: 'Reliable Moving Service',
      description: 'From planning to delivery, we focus on clear communication, dependable service, and your peace of mind.',
      icon: 'tabler:shield-check',
    },
  ]}
>
<Fragment slot="bg">
  <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
</Fragment>
  <!-- 7. Price and availability -->
</Features2>
  

  <!-- 9. Objections, also exposed as FAQPage structured data -->


  <!-- 10. Close -->

</Layout>
