---
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/hero__.astro';
import Stats from '~/components/widgets/Stats.astro';

import Team from '~/components/widgets/Team.astro';
import Timeline from '~/components/widgets/Timeline.astro';
import Layout from '~/layouts/PageLayout.astro';


import about from '~/assets/images/about.jpg';
import team_ from '~/assets/images/teamL/teaml_1.jpg';
import team from '~/assets/images/teamL/teaml_2.jpg';
import team__ from '~/assets/images/teamL/teaml_3.jpg';
import team___ from '~/assets/images/teamL/teaml_4.jpg';


const metadata = {
  title: 'About us',
  description:
    'About page demo built with AstroWind: hero, stats, feature grids and timelines ready to describe your company.',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

 <Hero
  
    image={{
     src: about,
      alt: 'Trustpack Mover Team',
    }}
  >
    <Fragment slot="title">
      Moves<br />
      <span class="text-accent dark:text-white">With Trustpack Mover</span>
    </Fragment>

    <Fragment slot="subtitle">
      Trustpack Mover was founded to address the safety and logistical challenges of moving goods in Ethiopia. We have successfully relocated corporate organizations, embassies, and Many Homes with full care and accountability.
    </Fragment>
  </Hero>

  <!-- Stats Widget ****************** -->

  <Stats
    title="Statistics about us"
    countUp
    stats={[
      { title: 'Offices', amount: '4' },
      { title: 'Employees', amount: '160' },
      { title: 'Awards', amount: '13' },
      { title: 'Moves', amount: '2700' },
    ]}
  />
  

  <!-- Features3 Widget ************** -->

  <Features3
    title="Our Moving Services"
    columns={3}
    isBeforeContent={true}
    items={[
    {
  title: 'Corporate & Office Relocation',
  description:
    'We carefully pack, load, transport, unpack, and reassemble office furniture and equipment to help businesses relocate smoothly.',
  icon: 'tabler:building',
},
{
  title: 'Full Residential Moving',
  description:
    'We move villas, apartments, condominiums, and high-rise homes with careful handling to protect your belongings.',
  icon: 'tabler:home',
},
{
  title: 'Electronics & TV Mounting',
  description:
    'We provide protective packing and careful transportation for large smart TVs and other valuable electronic equipment, with installation support where available.',
  icon: 'tabler:device-tv',
},
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    columns={3}
    isAfterContent={true}
    items={[
 
  {
    title: 'Residential Moving',
    description:
      'Move your household belongings safely and easily with our careful packing, loading, and transportation services.',
    icon: 'tabler:home',
  },
  {
    title: 'Commercial Moving',
    description:
      'Relocate offices, shops, and business equipment with organized planning and minimal disruption to your work.',
    icon: 'tabler:building',
  },
  {
    title: 'Packing Services',
    description:
      'Protect your belongings with careful packing and organized preparation for a smooth and secure move.',
    icon: 'tabler:package',
  },
  {
    title: 'Loading and Unloading',
    description:
      'Our team handles your furniture, boxes, and other belongings carefully during loading and unloading.',
    icon: 'tabler:truck-loading',
  },
  {
    title: 'Furniture Transportation',
    description:
      'Transport furniture and household items with care from your current location to your new destination.',
    icon: 'tabler:truck',
  },
  {
    title: 'Reliable Delivery',
    description:
      'We prioritize safe handling, clear communication, and timely delivery to make your moving experience easier.',
    icon: 'tabler:clock-check',
  },
]}
  
  />

  <!-- Steps2 Widget ****************** -->

 

  <!-- Timeline Widget **************** -->
<Timeline
  id="achievements"
  tagline="Company Journey & Future Roadmap"
  title="Our Milestones & Vision"
  subtitle="Building Ethiopia’s dependable, integrated platform for logistics, commercial transport, and professional cleaning services."
  layout="alternate"
  items={[
    {
      date: 'Foundation',
      title: 'Established to Address Moving & Logistics Challenges',
      description:
        'Founded to solve everyday transportation, moving security, and space management challenges faced by individuals and organizations in Ethiopia.',
      icon: 'tabler:rocket',
    },
 {
      date: 'Strategic Expansion',
      title: 'Corridor Operations & Fleet Deployment',
      description:
        'Established primary freight operations along the Addis Ababa–Adama commercial corridor, backed by our dedicated Eicher and Kiya transport fleet.',
      icon: 'tabler:truck-loading',
    },
    {
      date: 'Dual Service Growth',
      title: 'Integrated Relocation & Professional Cleaning Platform',
      description:
        'Expanded our portfolio to deliver integrated logistics, high-security embassy moves, corporate relocations (such as Trade Link PLC), and professional cleaning services.',
      icon: 'tabler:sparkles',
      highlight: true,
    },
    {
      date: 'Future Vision',
      title: 'Fleet Expansion & Technology-Driven Growth',
      description:
        'Targeting 5 dedicated trucks, enhanced digital booking systems, expanded regional coverage, and institutional long-term contracts across East Africa.',
      icon: 'tabler:target-arrow',
    },
  ]}
/>
  <!-- Team Widget ******************** -->
<Team
    id="team"
    tagline="Our Experts"
    title="Meet the Trustpack Team"
    subtitle="Dedicated relocation specialists committed to delivering smooth, stress-free moving experiences across Ethiopia."
 
    members={[
      {
        name: 'Berhanu Truneh',
        role: ' Manager',
        image: {
          src: team,
          alt: 'Berhanu Truneh',
        },
        bio: 'TrustPack and Movers',
    
      },
      {
        name: 'Lideta Werku',
        role: 'Deputy Manager & Call Center',
        image: {
          src: team_,
          alt: "Lideta Werku"
        },
        bio: "TrustPack and Movers",
      
      },
      {
        name: 'Wedebu Kifetew',
        role: 'Supervisor',
        image: {
          src: team__,
          alt: 'Wedebu Kifetew',
        },
        bio: "TrustPack and Movers",
       
      },
      {
        name: 'Gebre Abera',
        role: 'Supervisor',
        image: {
          src: team___,
          alt: 'Gebre Abera',
        },
        bio: "TrustPack and Movers",
      
      },
    ]}
  />

  <!-- Features2 Widget ************** -->


  <Features2
    title="Contact & Locations"
    tagline="Find Us"
    columns={4}
    items={[
      {
        title: 'Fiyel Bet Branch',
        description: 'Fiyel Bet (30m road), Addis Ababa, Ethiopia',
        icon: 'tabler:map-pin',
      },
      {
        title: 'Kality Branch',
        description: 'Sheger Building, Kality, Addis Ababa, Ethiopia',
        icon: 'tabler:map-pin',
      },
      {
        title: 'Telephone',
        description: '0968777773 / 0909388181',
        icon: 'tabler:phone',
      },
      {
        title: 'Telegram',
        description: '@Trustpackandmovers',
        icon: 'tabler:brand-telegram',
      },
    ]}
  />

  <!-- Features2 Widget ************** -->

</Layout>
