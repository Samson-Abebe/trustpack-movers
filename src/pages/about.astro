---
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/hero__.astro';
import Stats from '~/components/widgets/Stats.astro';

import Team from '~/components/widgets/Team.astro';
import Timeline from '~/components/widgets/Timeline.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About us',
  description:
    'About page demo built with AstroWind: hero, stats, feature grids and timelines ready to describe your company.',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

 <Hero
    tagline="About Us"
    image={{
     src: 'https://images.unsplash.com/photo-1600518464441-9154a4dea21b?w=2070&q=80',
      alt: 'Trustpack Mover Team',
    }}
  >
    <Fragment slot="title">
      Safe and Reliable Relocation Services in Ethiopia <br />
      <span class="text-accent dark:text-white">With Trustpack Mover</span>
    </Fragment>

    <Fragment slot="subtitle">
      Trustpack Mover was founded to address the safety and logistical challenges of moving goods in Ethiopia. We have successfully relocated corporate organizations, embassies, and Many Homes with full care and accountability.
    </Fragment>
  </Hero>

  <!-- Stats Widget ****************** -->

  <Stats
    title="Statistics about us"
    countUp
    stats={[
      { title: 'Offices', amount: '4' },
      { title: 'Employees', amount: '248' },
      { title: 'Templates', amount: '12' },
      { title: 'Awards', amount: '24' },
    ]}
  />
  

  <!-- Features3 Widget ************** -->

  <Features3
    title="Our Moving Services"
    subtitle="From office and residential relocations to electronics transportation and special-item packing, we handle every move with care, safety, and reliability."
    columns={3}
    isBeforeContent={true}
    items={[
    {
  title: 'Corporate & Office Relocation',
  description:
    'We carefully pack, load, transport, unpack, and reassemble office furniture and equipment to help businesses relocate smoothly.',
  icon: 'tabler:building',
},
{
  title: 'Full Residential Moving',
  description:
    'We move villas, apartments, condominiums, and high-rise homes with careful handling to protect your belongings.',
  icon: 'tabler:home',
},
{
  title: 'Electronics & TV Mounting',
  description:
    'We provide protective packing and careful transportation for large smart TVs and other valuable electronic equipment, with installation support where available.',
  icon: 'tabler:device-tv',
},
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    columns={3}
    isAfterContent={true}
    items={[
 
  {
    title: 'Residential Moving',
    description:
      'Move your household belongings safely and easily with our careful packing, loading, and transportation services.',
    icon: 'tabler:home',
  },
  {
    title: 'Commercial Moving',
    description:
      'Relocate offices, shops, and business equipment with organized planning and minimal disruption to your work.',
    icon: 'tabler:building',
  },
  {
    title: 'Packing Services',
    description:
      'Protect your belongings with careful packing and organized preparation for a smooth and secure move.',
    icon: 'tabler:package',
  },
  {
    title: 'Loading and Unloading',
    description:
      'Our team handles your furniture, boxes, and other belongings carefully during loading and unloading.',
    icon: 'tabler:truck-loading',
  },
  {
    title: 'Furniture Transportation',
    description:
      'Transport furniture and household items with care from your current location to your new destination.',
    icon: 'tabler:truck',
  },
  {
    title: 'Reliable Delivery',
    description:
      'We prioritize safe handling, clear communication, and timely delivery to make your moving experience easier.',
    icon: 'tabler:clock-check',
  },
]}
    image={{
    src: 'https://images.unsplash.com/photo-1497366754035-f200968a6e72?w=1740&q=80',
      alt: 'Colorful Image',
    }}
  />

  <!-- Steps2 Widget ****************** -->

 

  <!-- Timeline Widget **************** -->
<Timeline
    id="achievements"
    tagline="Milestones & Track Record"
    title="Key Achievements"
    subtitle="Our journey of delivering dependable relocation, warehousing, and corporate moving solutions across Ethiopia."
    layout="alternate"
    items={[
      {
        date: 'Founded',
        title: 'Safety-First Relocation Model',
        description:
          'Established to solve moving security challenges in Ethiopia by offering 100% accountable, all-inclusive packing and transport.',
        icon: 'tabler:shield-check',
      },
      {
        date: 'Corporate Growth',
        title: 'Trusted by Enterprise & Corporate Clients',
        description:
          'Partnered with major corporate entities like Trade Link PLC, embassies, and institutions for seamless office relocations with minimal downtime.',
        icon: 'tabler:building-skyscraper',
      },
      {
        date: 'Service Expansion',
        title: 'Warehousing & Specialized Assembly',
        description:
          'Expanded operations to include secure temporary storage facilities alongside expert TV mounting and complex furniture dismantling.',
        icon: 'tabler:building-warehouse',
      },
      {
        date: 'Present Day',
        title: 'Successful Moves',
        description:
          'Recognized as a leading professional moving service across Addis Ababa and regional routes, backed by top customer satisfaction.',
        icon: 'tabler:award',
        highlight: true,
      },
    ]}
  />

  <!-- Team Widget ******************** -->

  <Team
    id="team"
    tagline="The people"
    title="Meet the team"
    subtitle="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Morbi sagittis, quam nec venenatis lobortis, mi risus tempus nulla."
    members={[
      {
        name: 'Alicia Rivera',
        role: 'Founder & CEO',
        image: {
          src: 'https://images.unsplash.com/photo-1618835962148-cf177563c6c0?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=930&q=80',
          alt: 'Alicia Rivera',
        },
        bio: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit.',
        socials: [
          { icon: 'tabler:brand-linkedin', href: 'https://www.linkedin.com/', ariaLabel: 'LinkedIn' },
          { icon: 'tabler:brand-x', href: 'https://x.com/', ariaLabel: 'X' },
        ],
      },
      {
        name: 'Daniel Okafor',
        role: 'Lead developer',
        image: {
          src: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=800&q=80',
          alt: 'Daniel Okafor',
        },
        bio: 'Morbi sagittis, quam nec venenatis lobortis, mi risus tempus nulla.',
        socials: [{ icon: 'tabler:brand-github', href: 'https://github.com/', ariaLabel: 'GitHub' }],
      },
      {
        name: 'Mei Tanaka',
        role: 'Product designer',
        image: {
          src: 'https://images.unsplash.com/photo-1494790108377-be9c29b29330?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=800&q=80',
          alt: 'Mei Tanaka',
        },
        bio: 'Sed porttitor est nibh at nulla. Cras semper nulla leo, eget laoreet erat.',
        socials: [{ icon: 'tabler:brand-dribbble', href: 'https://dribbble.com/', ariaLabel: 'Dribbble' }],
      },
      {
        name: 'Jonas Weber',
        role: 'Customer success',
        image: {
          src: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=800&q=80',
          alt: 'Jonas Weber',
        },
        bio: 'Praesent faucibus massa in purus iaculis dictum.',
        socials: [{ icon: 'tabler:brand-linkedin', href: 'https://www.linkedin.com/', ariaLabel: 'LinkedIn' }],
      },
    ]}
  />

  <!-- Features2 Widget ************** -->


  <Features2
    title="Contact & Locations"
    tagline="Find Us"
    columns={4}
    items={[
      {
        title: 'Fiyel Bet Branch',
        description: 'Fiyel Bet (30m road), Addis Ababa, Ethiopia',
        icon: 'tabler:map-pin',
      },
      {
        title: 'Kality Branch',
        description: 'Sheger Building, Kality, Addis Ababa, Ethiopia',
        icon: 'tabler:map-pin',
      },
      {
        title: 'Telephone',
        description: '0968777773 / 0909388181',
        icon: 'tabler:phone',
      },
      {
        title: 'Telegram',
        description: '@Trustpackandmovers',
        icon: 'tabler:brand-telegram',
      },
    ]}
  />

  <!-- Features2 Widget ************** -->

</Layout>
