---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Brands from '~/components/widgets/Brands.astro';
import OfficeMap from '../components/widgets/officmap.astro';

const metadata = {
  title: 'Contact',
  description:
    'Contact page demo built with AstroWind: a form, contact details and support links in one accessible layout.',
};
---
<!-- kality81  fiyel bet73 -->

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText tagline="Contact" title="Let's Connect!" />

  <ContactUs
    id="form"
    title="Drop us a message today!"
    subtitle="For quicker answers, explore our FAQs section. You may find the solution you're looking  for right there! If not, our support team is delighted to help you."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Name',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email',
      },
    ]}
    textarea={{
      label: 'Message',
    }}
    disclaimer={{
      label:
        'By submitting this contact form, you acknowledge and agree to the collection of your personal information.',
    }}
    description="Our support team typically responds within 24 business hours."
  />

  <!-- Features2 Widget ************** -->
<Features2
    title="We are here to help!"
    subtitle="Reach out to Trustpack Mover via call, email, or visit our local offices in Addis Ababa."
    items={[
      {
        title: 'Phone / Call Center',
        description: '0968777773 / 0909388181',
        icon: 'tabler:headset',
      },
      {
        title: 'Email',
        description: 'Trustpackandmove09@gmail.com',
        icon: 'tabler:mail',
      },
      {
        title: 'Location',
        description: 'Addis Ababa, Ethiopia Fiyel Bet (30m) & Kality Sheger Building',
        icon: 'tabler:map-pin',
      },
    ]}
  />

<div class="space-y-8">
  <!-- First Office: Kality -->
<OfficeMap 
  officeName="Kality - Addis Ababa"
  address="  "
  mapEmbedUrl="https://www.google.com/maps/embed?pb=!1m17!1m12!1m3!1d3941.7752547433147!2d38.767475999999995!3d8.900474999999998!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m2!1m1!2zOMKwNTQnMDEuNyJOIDM4wrA0NicwMi45IkU!5e0!3m2!1sen!2set!4v1794746704912!5m2!1sen!2set"
  mapLink="https://goo.gl/maps/s7EsmigPteaFeH3B7"
  phone="+251 909388181"
  email="Trustpackandmove09@gmail.com"
/>

  <!-- Second Office: Ethiopia Fiyel Bet -->
<OfficeMap 
  officeName="CMC - Addis Ababa"
  address="Fiyel Bet (30m)"
  mapEmbedUrl="https://www.google.com/maps/embed?pb=!1m13!1m8!1m3!1d1648.5032231187065!2d38.856254639772125!3d9.009466051647717!3m2!1i1024!2i768!4f13.1!3m2!1m1!2zOcKwMDAnMzQuOSJOIDM4wrA1MScyMi44IkU!5e0!3m2!1sen!2set!4v1794746790076!5m2!1sen!2set"
  mapLink="https://maps.google.com/maps?q=9.009681,38.856319&ll=9.009681,38.856319&z=16"
  phone="+251 968777773"
  email="Trustpackandmove09@gmail.com"
/>
</div>


<Brands
  variant="marquee"
  grayscale={false}
  boxed={true}
  title="Connect With Us"
  subtitle="Follow our social channels for updates, news, and collaborations."
  icons={[
    { name: 'tabler:brand-facebook', href: 'https://www.facebook.com/trustpack.mover' },
    { name: 'tabler:brand-instagram', href: 'https://www.instagram.com/trustpackandmover?xtok=NjBiejRocWZ3Y2tv' },
  
    { name: 'tabler:brand-tiktok', href: 'https://vm.tiktok.com/ZS9f6N5b8qSta-qEdhm/' },
{ name: 'tabler:brand-telegram', href: 'https://t.me/+ndcozE8Xd2liMmFk' },
  ]}
  images={[]}
/>
</Layout>
