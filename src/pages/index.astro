---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import mark from '~/assets/images/profileicon.webp?url';
import Features from '~/components/widgets/Features.astro';
import QuickStart from '~/components/widgets/QuickStart.astro';

import Timeline from '~/components/widgets/Timeline.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogHighlightedPosts from '~/components/widgets/BlogHighlightedPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Projects from '~/components/widgets/Projects.astro';
import SocialProof from '~/components/widgets/SocialProof.astro';

import { SITE, METADATA, I18N } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';
import Testimonials from '~/components/widgets/Testimonials.astro';
import { getPermalink} from '~/utils/permalinks';
import { Image } from 'astro:assets';

import spic from '~/assets/images/servic/servic_1.jpg';
import spic_ from '~/assets/images/servic/servic_2.jpg';
import spic__ from '~/assets/images/servic/servic_3.jpg';
import spic___ from '~/assets/images/servic/servic_4.jpg';
import spic____ from '~/assets/images/servic/servic_5.jpg';
import spic_____ from '~/assets/images/servic/servic_6.webp';
import corp from '~/assets/images/coreproject/coreproject_1.jpg';
import corp_ from '~/assets/images/coreproject/hero_2.jpg';

//this is to add the startup on the routing

//finshid hir
const metadata = {
  title: 'Trustpack Mover — Professional Packing & Moving Services in Ethiopia',
  ignoreTitleTemplate: true,
};

// Structured data for the site and its publisher, built only from
// `src/config.yaml` (`site.name`, `site.site`, `metadata.twitter.handle`), so
// it is correct for any site made with the template. Blog posts add
// BlogPosting on their own; the FAQs widget adds FAQPage.
const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
    ...(METADATA?.twitter?.handle ? { sameAs: [`https://x.com/${METADATA.twitter.handle.replace(/^@/, '')}`] } : {}),
  },
];
